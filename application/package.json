{
	"name": "YourRadio",
	"version": "4.0.1.0.115.0",
	"comments": "Ваше Радио. Облегчённая версия. Самостоятельное добавление радио потока. Импорт/Экспорт плейлиста радиостанций.",
	"description": "Ваше Радио. Облегчённая версия.",
	"buildDate": "5 September 2026 12:30:02",
	"author": "ProjectSoft",
	"homepage": "https://github.com/ProjectSoft-STUDIONIONS/radioApp-lite",
	"license": "GPL-3.0",
	"main": "index.html",
	"nodejs": true,
	"chromium-args": "--child-clean-exit --ignore-certificate-errors --disk-cache-size=1 --media-cache-size=1 --disable-web-security --use-strict=true --allow-running-insecure-content",
	"winIco": "favicon.ico",
	"page-cache": false,
	"default_locale": "en",
	"webkit": {
		"plugin": true
	},
	"window": {
		"exe_icon": "favicon.png",
		"title": "Ваше Радио",
		"frame": false,
		"kiosk_emulation": true,
		"icon": "favicon.png",
		"id": "radioapp-lite",
		"mac_icon": "favicon.png",
		"position": "center",
		"resizable": true,
		"show_in_taskbar": true,
		"node-integration": true,
		"toolbar": true,
		"visible": true,
		"visible_on_all_workspaces": true,
		"min_width": 730,
		"min_height": 700
	},
	"dependencies": {
		"butterchurn": "^2.6.7",
		"icy": "latest",
		"mime": "latest",
		"node-notifier": "^10.0.1",
		"string_decoder": "latest",
		"transliteration": "^2.6.1"
	}
}