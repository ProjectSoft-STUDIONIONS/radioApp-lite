doctype html
html
	head
		base(href="/")
		meta(http-equiv="Content-Type" content="text/html; charset=UTF-8")
		meta(name="viewport" content="width=device-width, initial-scale=1")
		link(rel="stylesheet" type="text/css" href="css/main.css?" + hash)
		link(rel="shortcut icon" href="favicon.ico")
		//- style="--background-custom: url(http://localhost:4000/background);"
	body(class="custom "+target)
		header#TitleBar
			#TitleBar-icon
				img(src="favicon.ico" alt="YR")
			#TitleBar-text
				span
			#TitleBar-buttons
				span#settings(data-i18n-title="settingsTitle")
					include ../svg/settings-0001.svg
				span#fullscreen(data-i18n-title="fullscreenOn")
					include ../svg/fullscreen.svg
				span#minimized(data-i18n-title="minimize")
					include ../svg/minimized.svg
				span#restored(data-i18n-title="default")
					include ../svg/maximized.svg
				span#close(data-i18n-title="close")
					include ../svg/close.svg
		main.notcontext.loading
			.genre
				ul#genre.genre_list
			.container
				.row
					ul#radio-list
				.volume-block
					input#volume(min="0" max="100" value="50" step="1" type="range")
			.vizualizer
				canvas
		footer.clearfix
			.footer_wrap
				p.right
					a.github.icon-github(href="https://github.com/ProjectSoft-STUDIONIONS/radioApp-lite" target="_blank", title="https://github.com/ProjectSoft-STUDIONIONS/radioApp-lite" tabindex="-1")
				p.text-center.developed_by
					a.icon-hack(href="https://github.com/ProjectSoft-STUDIONIONS" target="_blank" title="https://github.com/ProjectSoft-STUDIONIONS" tabindex="-1")
					|Developed by  
					a(href="https://vk.com/projectsoft" target="_blank" title="https://vk.com/projectsoft" tabindex="-1") ProjectSoft
					br
					|&copy; 2008 - all
				.left
					span.writ.teest
						|0%
					//- span#testBtn(class="icon-deezer " + target)
		dialog.appBlock
		//- type = alert, confirm
		dialog.dialogBox(type="alert")
			p.wrap
			.buttons
				button#ok(type="button" data-i18n="ok")
				button#cancel(type="button" data-i18n="cancel")
		dialog.settings-block
			h3.settingsTitle.text-center(data-i18n="settingsTitle")
				|
			.block-options
				.labels
					label
						input#clear_stations(type="checkbox")
						span.settingsEmpty(data-i18n="settingsEmpty")
					label
						input#loadDefault(type="checkbox")
						span.settingsDefault(data-i18n="settingsDefault")
					label
						input#notify(type="checkbox")
						span.settingsNotify(data-i18n="settingsNotify")
					label
						input#presetsRandom(type="checkbox")
						span.settingsNotify(data-i18n="presetsRandom")
					label.select
						span.settingsNotify(data-i18n="selectPreset")
						select#selectPreset
					div
						label
							input#custombg(type="checkbox")
							span.settingsCustomBg(data-i18n="settingsCustomBg")
						div.customBg
							.preview
								label
									input(type="file" id="background" accept="image/*")
				.buttons-options
					button#okSettings(type="button" data-i18n="ok")
					button#noSettings(type="button" data-i18n="cancel")
		#cropTmp
		script(type="text/javascript" src="js/butterchurn.js?" + hash)
		script(type="text/javascript" src="js/main.js?" + hash)
